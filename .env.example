# Live School Environment Configuration
# Duplicate this file to .env and configure for your environment.

# Set DEBUG=False for production deployments
DEBUG=True

# In production, generate a secure random key (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=django-insecure-dev-local-liveschool-int253-not-for-production

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost

# Required in production. Use a PostgreSQL URL and private S3-compatible bucket.
# DATABASE_URL=
# CSRF_TRUSTED_ORIGINS=
# MEDIA_BUCKET=
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_ENDPOINT_URL=
# MEDIA_REGION=us-east-1

# Jitsi domain for WebRTC live classrooms
JITSI_DOMAIN=meet.jit.si

# Production SSL Hardening (enable when running with HTTPS domain)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
